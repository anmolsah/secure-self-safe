# Supabase Project Configuration
# Replace with your actual Supabase project credentials.
# The publishable / anon key is public by design; Row Level Security (RLS) protects the database.
# Never commit your .env file or service_role secret keys.

SUPABASE_PROJECT_ID="your-project-id"
SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
SUPABASE_URL="https://your-project-id.supabase.co"

VITE_SUPABASE_PROJECT_ID="your-project-id"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-or-anon-key"
VITE_SUPABASE_URL="https://your-project-id.supabase.co"
